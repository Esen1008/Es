# ==================== Telegram 命令 ====================
def start(update, context):
    user_id = update.effective_user.id
    user = get_user(user_id)
    
    # 检查是否已注册
    if user.get('username') is None:
        update.message.reply_text(
            "🎉 欢迎来到皇家至尊娱乐城！\n\n"
            "请先设置你的用户名：\n"
            "请输入一个独一无二的昵称（最多10个字）"
        )
        return WAITING_USERNAME
    
    text, kb = get_main_menu(user_id)
    update.message.reply_text(text, reply_markup=InlineKeyboardMarkup(kb))
    return ConversationHandler.END

def handle_username(update, context):
    """处理用户注册"""
    user_id = update.effective_user.id
    user = get_user(user_id)
    username = update.message.text.strip()
    
    if len(username) > 10:
        update.message.reply_text("❌ 昵称不能超过10个字，请重新输入：")
        return WAITING_USERNAME
    
    # 检查用户名是否已被占用
    for uid, data in USER_DATA.items():
        if data.get('username') == username and uid != user_id:
            update.message.reply_text("❌ 该昵称已被占用，请换一个：")
            return WAITING_USERNAME
    
    user['username'] = username
    save_user(user_id)
    update.message.reply_text(f"✅ 注册成功！\n👤 你的昵称: {username}\n\n发送 /start 开始游戏！")
    return ConversationHandler.END

def cancel(update, context):
    update.message.reply_text("❌ 已取消注册，发送 /start 重新开始")
    return ConversationHandler.END

def setname(update, context):
    """修改昵称"""
    user_id = update.effective_user.id
    user = get_user(user_id)
    
    if len(context.args) == 0:
        update.message.reply_text("❌ 用法: /setname 新昵称\n例如: /setname 张三")
        return
    
    username = ' '.join(context.args)
    if len(username) > 10:
        update.message.reply_text("❌ 昵称不能超过10个字")
        return
    
    user['username'] = username
    save_user(user_id)
    update.message.reply_text(f"✅ 昵称已修改！\n👤 新的昵称: {username}")

def button(update, context):
    query = update.callback_query
    query.answer()
    user_id = update.effective_user.id
    user = get_user(user_id)
    data = query.data

    if data == "back":
        text, kb = get_main_menu(user_id)
        query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(kb))
        return

    if data == "play":
        if user['balance'] < 10:
            query.edit_message_text("❌ 余额不足，最低10元")
            return
        kb = [
            [InlineKeyboardButton("10", callback_data="bet_10"), InlineKeyboardButton("50", callback_data="bet_50")],
            [InlineKeyboardButton("100", callback_data="bet_100"), InlineKeyboardButton("500", callback_data="bet_500")],
            [InlineKeyboardButton("🔙 返回", callback_data="back")],
        ]
        query.edit_message_text(f"🎲 下注金额\n💰 余额: {user['balance']:.2f}元", reply_markup=InlineKeyboardMarkup(kb))
        return

    if data.startswith("bet_"):
        bet = float(data.split("_")[1])
        if bet > user['balance']:
            query.edit_message_text("❌ 余额不足")
            return
        
        user['balance'] -= bet
        deck = shuffle_cards()
        p_hand = deck[:5]
        d_hand = deck[5:10]
        p_name, p_mult = calc_niu(p_hand)
        d_name, d_mult = calc_niu(d_hand)

        if p_mult > d_mult:
            win = bet * p_mult
            user['balance'] += win
            user['wins'] += 1
            user['profit'] += win - bet
            user['daily_profit'] += win - bet
            user['weekly_profit'] += win - bet
            user['monthly_profit'] += win - bet
            result = f"🎉 赢了！+{win:.0f}元 (x{p_mult})"
        elif p_mult < d_mult:
            user['losses'] += 1
            user['profit'] -= bet
            user['daily_profit'] -= bet
            user['weekly_profit'] -= bet
            user['monthly_profit'] -= bet
            result = f"💔 输了！-{bet:.0f}元"
        else:
            user['balance'] += bet
            result = "🤝 平局"

        user['total_games'] += 1
        user['turnover'] += bet
        
        # 返佣计算（投注额的百分比）
        rebate_rate = get_rebate_rate(user)
        rebate_amount = bet * rebate_rate
        user['rebate'] = user.get('rebate', 0) + rebate_amount
        
        reset_profit_periods(user_id)
        save_user(user_id)

        text = f"🎴 你: {show_cards(p_hand)} → {p_name}\n"
        text += f"🎴 庄: {show_cards(d_hand)} → {d_name}\n"
        text += f"{result}\n"
        text += f"💰 余额: {user['balance']:.2f}元\n"
        text += f"🧧 返佣: +{rebate_amount:.2f}元"
        kb = [
            [InlineKeyboardButton("🔄 再来一局", callback_data="play")],
            [InlineKeyboardButton("🔙 返回大厅", callback_data="back")]
        ]
        query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(kb))
        return

    if data == "wallet":
        text = (
            f"💰 钱包\n"
            f"余额: {user['balance']:.2f}元\n"
            f"盈利: {user['profit']:.2f}元\n"
            f"总流水: {user['turnover']:.2f}元\n"
            f"未领取返佣: {user.get('rebate', 0):.2f}元"
        )
        kb = [[InlineKeyboardButton("🔙 返回", callback_data="back")]]
        query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(kb))
        return

    if data == "stats":
        wr = (user['wins'] / user['total_games'] * 100) if user['total_games'] > 0 else 0
        text = (
            f"📈 战绩\n"
            f"总局: {user['total_games']}\n"
            f"胜: {user['wins']} 负: {user['losses']}\n"
            f"胜率: {wr:.1f}%\n"
            f"总盈利: {user['profit']:.2f}元"
        )
        kb = [[InlineKeyboardButton("🔙 返回", callback_data="back")]]
        query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(kb))
        return

    if data == "signin":
        today = datetime.now().strftime("%Y-%m-%d")
        if user.get('last_signin') == today:
            query.edit_message_text("❌ 今天已签到！明天再来吧")
            return
        reward = 50 + user.get('signin_streak', 0) * 10
        user['balance'] += reward
        user['last_signin'] = today
        user['signin_streak'] = user.get('signin_streak', 0) + 1
        save_user(user_id)
        text = (
            f"✅ 签到成功！获得 {reward} 元\n"
            f"连续签到: {user['signin_streak']} 天\n"
            f"💰 余额: {user['balance']:.2f}元"
        )
        kb = [[InlineKeyboardButton("🔙 返回", callback_data="back")]]
        query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(kb))
        return

    if data == "claim_rebate":
        rebate = user.get('rebate', 0)
        if rebate <= 0:
            query.edit_message_text("❌ 当前没有可领取的返佣")
            return
        user['balance'] += rebate
        user['claimed_rebate'] = user.get('claimed_rebate', 0) + rebate
        user['rebate'] = 0
        save_user(user_id)
        text = f"✅ 领取返佣成功！\n💰 获得 {rebate:.2f} 元\n💰 当前余额: {user['balance']:.2f}元"
        kb = [[InlineKeyboardButton("🔙 返回", callback_data="back")]]
        query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(kb))
        return

    if data == "rank":
        kb = [
            [InlineKeyboardButton("📅 日排行榜", callback_data="rank_daily")],
            [InlineKeyboardButton("📆 周排行榜", callback_data="rank_weekly")],
            [InlineKeyboardButton("📊 月排行榜", callback_data="rank_monthly")],
            [InlineKeyboardButton("🔙 返回", callback_data="back")],
        ]
        query.edit_message_text("🏆 **排行榜**\n请选择时间范围：", reply_markup=InlineKeyboardMarkup(kb), parse_mode='Markdown')
        return

    if data.startswith("rank_"):
        period = data.split("_")[1]
        period_names = {
            'daily': '📅 日排行榜',
            'weekly': '📆 周排行榜',
            'monthly': '📊 月排行榜'
        }
        rankings = get_rankings(period)
        text = f"{period_names.get(period, '排行榜')}\n\n"
        if rankings:
            medals = ['🥇', '🥈', '🥉']
            for i, (name, profit) in enumerate(rankings, 1):
                medal = medals[i-1] if i <= 3 else f"{i}."
                text += f"{medal} {name}  {profit:+.2f}元\n"
        else:
            text += "暂无数据"
        
        kb = [
            [InlineKeyboardButton("🔄 刷新", callback_data=f"rank_{period}")],
            [InlineKeyboardButton("🔙 返回", callback_data="rank")]
        ]
        query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(kb))
        return

# ==================== Web 服务器 + 自动保活 ====================
class WebHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"OK")
    def log_message(self, format, *args):
        pass

def run_web_server():
    try:
        server = HTTPServer(('0.0.0.0', 8080), WebHandler)
        server.serve_forever()
    except:
        pass

def keep_alive():
    url = "https://jingyun1.onrender.com"
    while True:
        try:
            requests.get(url, timeout=5)
        except:
            pass
        time.sleep(300)

def main():
    threading.Thread(target=run_web_server, daemon=True).start()
    threading.Thread(target=keep_alive, daemon=True).start()
    
    updater = Updater(TOKEN)
    dp = updater.dispatcher
    
    # 注册流程（ConversationHandler）
    conv_handler = ConversationHandler(
        entry_points=[CommandHandler("start", start)],
        states={
            WAITING_USERNAME: [MessageHandler(Filters.text & ~Filters.command, handle_username)],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
    )
    dp.add_handler(conv_handler)
    
    # 其他命令
    dp.add_handler(CommandHandler("setname", setname))
    dp.add_handler(CallbackQueryHandler(button))
    
    print("=" * 40)
    print("🤖 皇家至尊娱乐城 Bot 已启动！")
    print("🌐 Web 服务器已启动，端口 8080")
    print("💓 自动保活已启动（每5分钟心跳）")
    print("=" * 40)
    
    updater.start_polling()
    updater.idle()

if __name__ == "__main__":
    main()
